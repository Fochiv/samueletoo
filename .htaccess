Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(git|agents|local)(/|$) - [F,L]
</IfModule>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "^(\\.env|\\.env\\.example|composer\\.(json|lock)|README\\.md)$">
  Require all denied
</FilesMatch>
<FilesMatch "\\.(sql|log)$">
  Require all denied
</FilesMatch>
